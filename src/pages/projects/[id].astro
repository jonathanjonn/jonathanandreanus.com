---
import { Image } from "astro:assets";
import { render } from "astro:content";
import MediaGallery from "../../components/MediaGallery.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  coverTransitionName,
  getProjects,
  hasBody,
  type Project,
} from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const { title, summary, year, role, tags, links, cover, media } = project.data;
const { Content } = await render(project);
const hasDetails = Boolean(year || role || tags.length || links.length);
---

<BaseLayout
  title={title}
  description={summary}
  image={cover?.src}
  type="article"
>
  <article>
    <header class="shell pt-8 md:pt-12">
      <a
        href="/projects/"
        class="hover-line -ml-1 inline-flex min-h-11 items-center gap-2 px-1 text-meta"
      >
        <span aria-hidden="true">←</span> All work
      </a>
      <div class="mt-8 grid gap-y-8 md:mt-14 md:grid-cols-12 md:gap-x-8">
        <h1 class="font-display text-headline text-balance wrap-break-word md:col-span-11 lg:col-span-10">
          {title}
        </h1>
        <p class="max-w-[48ch] text-lead md:col-span-7">{summary}</p>
        {hasDetails && (
          <dl class="grid grid-cols-[6rem_minmax(0,1fr)] gap-y-3 self-start border-t border-line pt-4 text-meta md:col-span-4 md:col-start-9">
            {year && (
              <>
                <dt class="text-muted">Year</dt>
                <dd class="tabular-nums">{year}</dd>
              </>
            )}
            {role && (
              <>
                <dt class="text-muted">Role</dt>
                <dd>{role}</dd>
              </>
            )}
            {tags.length > 0 && (
              <>
                <dt class="text-muted">Stack</dt>
                <dd>{tags.join(", ")}</dd>
              </>
            )}
            {links.length > 0 && (
              <>
                <dt class="text-muted">Links</dt>
                <dd>
                  <ul class="-mt-3 flex flex-wrap gap-x-5">
                    {links.map((link) => (
                      <li>
                        <a
                          href={link.url}
                          rel="noopener"
                          class="inline-flex min-h-11 items-center"
                        >
                          {link.label}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </>
            )}
          </dl>
        )}
      </div>
    </header>

    {cover && (
      <figure class="shell mt-12 md:mt-20">
        <Image
          src={cover.src}
          alt={cover.alt}
          layout="full-width"
          sizes="(min-width: 90rem) 84rem, 92vw"
          priority
          class="w-full bg-surface"
          style={`view-transition-name: ${coverTransitionName(project)}`}
        />
      </figure>
    )}

    {hasBody(project) && (
      <div class="shell mt-14 grid md:mt-24 md:grid-cols-12 md:gap-x-8">
        <div class="prose md:col-span-8 md:col-start-3 lg:col-span-6 lg:col-start-4">
          <Content />
        </div>
      </div>
    )}

    {media.length > 0 && <MediaGallery items={media} />}

    {(previous || next) && (
      <nav
        aria-label="More projects"
        class="shell mt-24 grid md:mt-36 md:grid-cols-2 md:gap-x-8"
      >
        {previous && (
          <div class="card group border-t border-line py-6 md:py-8">
            <p class="text-meta text-muted">Previous</p>
            <a
              href={`/projects/${previous.id}/`}
              class="stretched-link hover-line mt-2 block font-display text-title text-balance"
            >
              {previous.data.title}
            </a>
          </div>
        )}
        {next && (
          <div class="card group border-t border-line py-6 md:col-start-2 md:py-8 md:text-right">
            <p class="text-meta text-muted">Next</p>
            <a
              href={`/projects/${next.id}/`}
              class="stretched-link hover-line mt-2 block font-display text-title text-balance"
            >
              {next.data.title}
            </a>
          </div>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
