---
import { Image } from "astro:assets";
import {
  coverTransitionName,
  getFeaturedProjects,
  getProjects,
} from "../lib/content";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  marker: string;
}

const { marker } = Astro.props;
const [featured, all] = await Promise.all([
  getFeaturedProjects(),
  getProjects(),
]);

/*
 * Layout: the first project leads across the full grid. The rest come in
 * pairs of one wide and one narrow column that swap sides from pair to pair;
 * the second item of each pair drops lower for an editorial stagger. A last
 * project without a partner takes the wide slot on its pair's wide side.
 */
const LEAD = {
  item: "md:col-span-12",
  width: 1600,
  height: 900,
  sizes: "(min-width: 90rem) 84rem, 92vw",
};
const WIDE = {
  width: 1200,
  height: 900,
  sizes: "(min-width: 64rem) 56vw, (min-width: 48rem) 46vw, 92vw",
};
const NARROW = {
  width: 960,
  height: 1200,
  sizes: "(min-width: 64rem) 31vw, (min-width: 48rem) 46vw, 92vw",
};

function slot(index: number) {
  if (index === 0) return LEAD;
  const pair = Math.floor((index - 1) / 2);
  const second = (index - 1) % 2 === 1;
  const wideFirst = pair % 2 === 0;
  if (!second && index === featured.length - 1) {
    return wideFirst
      ? { ...WIDE, item: "md:col-span-6 lg:col-span-7" }
      : { ...WIDE, item: "md:col-span-6 lg:col-span-7 lg:col-start-6" };
  }
  if (!second) {
    return wideFirst
      ? { ...WIDE, item: "md:col-span-6 lg:col-span-7" }
      : { ...NARROW, item: "md:col-span-6 lg:col-span-4" };
  }
  return wideFirst
    ? { ...NARROW, item: "md:col-span-6 lg:col-span-4 lg:col-start-9 lg:mt-40" }
    : { ...WIDE, item: "md:col-span-6 lg:col-span-7 lg:col-start-6 lg:mt-40" };
}
---

<section id="work" aria-labelledby="work-heading" class="shell pt-20 md:pt-32">
  <SectionHeader id="work-heading" marker={marker} label="Selected work" />
  <ol class="mt-10 grid gap-y-16 md:mt-16 md:grid-cols-12 md:gap-x-8 md:gap-y-24">
    {featured.map((project, index) => {
      const { title, summary, year, role, tags, cover } = project.data;
      const layout = slot(index);
      const lead = index === 0;
      return (
        <li class:list={["card group", layout.item]}>
          {cover && (
            <div class="overflow-hidden bg-surface">
              <Image
                src={cover.src}
                alt=""
                width={layout.width}
                height={layout.height}
                fit="cover"
                sizes={layout.sizes}
                priority={lead}
                class="w-full transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                style={`view-transition-name: ${coverTransitionName(project)}`}
              />
            </div>
          )}
          <div
            class:list={[
              cover ? "mt-5" : "border-t border-line pt-5",
              lead &&
                "md:grid md:grid-cols-12 md:grid-rows-[auto_1fr] md:gap-x-8",
            ]}
          >
            {(year || role) && (
              <p
                class:list={[
                  "flex flex-wrap gap-x-4 text-meta text-muted",
                  lead && "md:col-span-3 md:pt-2",
                ]}
              >
                {year && <span class="tabular-nums">{year}</span>}
                {role && <span>{role}</span>}
              </p>
            )}
            <div
              class:list={[
                lead &&
                  "md:col-span-7 md:col-start-4 md:row-span-2 md:row-start-1",
              ]}
            >
              <h3
                class:list={[
                  "mt-2 font-display text-balance",
                  lead
                    ? "text-title md:mt-0 lg:text-[3rem] lg:leading-[1.05]"
                    : "text-title",
                ]}
              >
                <a
                  href={`/projects/${project.id}/`}
                  class="stretched-link hover-line"
                >
                  {title}
                </a>
              </h3>
              <p class="mt-3 max-w-[56ch] text-muted">{summary}</p>
            </div>
            {tags.length > 0 && (
              <ul
                class:list={[
                  "dot-list mt-4 flex flex-wrap content-start text-meta",
                  lead && "md:col-span-3 md:col-start-1 md:mt-2",
                ]}
              >
                {tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })}
  </ol>
  {all.length > featured.length && (
    <p class="mt-16 border-t border-line pt-4 md:mt-24">
      <a href="/projects/" class="inline-flex min-h-11 items-center">
        All work ({all.length} projects)
      </a>
    </p>
  )}
</section>
