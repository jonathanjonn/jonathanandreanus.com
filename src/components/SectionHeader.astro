---
/**
 * Section label set on a hairline rule, like a magazine running head:
 * an accent marker (section number) and a small heading.
 */
interface Props {
  id: string;
  label: string;
  marker?: string;
  as?: "h1" | "h2" | "p";
}

const { id, label, marker, as: Heading = "h2" } = Astro.props;
---

<div class="flex items-baseline gap-4 border-t border-line pt-3 md:grid md:grid-cols-12 md:gap-x-8">
  {marker && (
    <span
      class="text-meta text-accent tabular-nums md:col-span-3"
      aria-hidden="true"
    >
      {marker}
    </span>
  )}
  <Heading
    id={id}
    class:list={[
      "text-meta font-medium",
      marker ? "md:col-span-9" : "md:col-span-12",
    ]}
  >
    {label}
  </Heading>
</div>
